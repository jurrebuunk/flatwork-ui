{
  "name": "flatwork-saas",
  "description": "Calm, flat, precise SaaS interface: Geist and IBM Plex Mono, one muted blue accent, 1px borders, shadows only on floating layers.",
  "prefix": "fw",
  "defaultMode": "dark",
  "modes": {
    "dark": {
      "bg": "#1b1818",
      "surface": "#221e1e",
      "surface-2": "#2a2525",
      "input": "#1b1818",
      "border": "#3a3434",
      "border-strong": "#4a4444",
      "heading": "#ece9e9",
      "text": "#c4c1c1",
      "muted": "#9a9595",
      "accent": "#8aa1a8",
      "accent-hover": "#9bb2b9",
      "on-accent": "#141212",
      "link": "#a5bbc2",
      "focus": "#a5bbc2",
      "danger": "#c97070",
      "on-danger": "#141212",
      "error": "#d88a8a",
      "error-bg": "#2a1e1e",
      "error-border": "#5c3434",
      "success": "#9dbca8",
      "success-bg": "#1d2520",
      "success-border": "#384c3f",
      "warning": "#cdae88",
      "warning-bg": "#28221b",
      "warning-border": "#54452f",
      "info": "#a5bbc2",
      "info-bg": "#1d2326",
      "info-border": "#3b494e",
      "overlay": "rgb(10 8 8 / .62)",
      "shadow-pop": "0 12px 32px rgb(0 0 0 / .35)",
      "border-hover": "#5a5353",
      "mark": "rgb(138 161 168 / .28)"
    },
    "light": {
      "bg": "#f6f5f5",
      "surface": "#ffffff",
      "surface-2": "#f1efef",
      "input": "#ffffff",
      "border": "#e4e0e0",
      "border-strong": "#d3cdcd",
      "heading": "#1b1818",
      "text": "#3a3535",
      "muted": "#625c5c",
      "accent": "#4b6670",
      "accent-hover": "#3f5961",
      "on-accent": "#ffffff",
      "link": "#3f5961",
      "focus": "#4b6670",
      "danger": "#a33b3b",
      "on-danger": "#ffffff",
      "error": "#a33b3b",
      "error-bg": "#fbf0f0",
      "error-border": "#efcaca",
      "success": "#3c6a4b",
      "success-bg": "#eef5f0",
      "success-border": "#c9dfd0",
      "warning": "#7a5626",
      "warning-bg": "#faf4ea",
      "warning-border": "#ead8bb",
      "info": "#3f5961",
      "info-bg": "#eef3f5",
      "info-border": "#cbd9de",
      "overlay": "rgb(27 24 24 / .38)",
      "shadow-pop": "0 12px 32px rgb(27 24 24 / .12)",
      "border-hover": "#bdb6b6",
      "mark": "rgb(75 102 112 / .2)"
    }
  },
  "font": {
    "font": "'Geist', ui-sans-serif, system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace"
  },
  "radius": {
    "r-xs": "4px",
    "r-sm": "6px",
    "r-md": "9px",
    "r-lg": "12px",
    "r-full": "999px"
  },
  "space": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-12": "48px"
  },
  "motion": {
    "motion-fast": "120ms",
    "motion-normal": "220ms",
    "easing": "ease-out"
  },
  "fontFaces": [
    {
      "family": "Geist",
      "weight": 400,
      "file": "fonts/geist-400.woff2"
    },
    {
      "family": "Geist",
      "weight": 500,
      "file": "fonts/geist-500.woff2"
    },
    {
      "family": "Geist",
      "weight": 600,
      "file": "fonts/geist-600.woff2"
    },
    {
      "family": "IBM Plex Mono",
      "weight": 400,
      "file": "fonts/plex-mono-400.woff2"
    }
  ]
}
