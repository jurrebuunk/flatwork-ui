{
  "name": "@flatwork-ui/react",
  "version": "0.2.0",
  "description": "React components for the Flatwork design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurrebuunk/flatwork-ui.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles/*.css": "./dist/styles/*/*.css",
    "./tokens/*.json": "./dist/styles/*/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/build-styles.mjs && vite showcase",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
